// ============================================================
// HopeAfter50 — Database Schema
// Claude Code: run `npx prisma migrate dev` to create tables
// Recommended DB: Vercel Postgres or PlanetScale
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NextAuth required tables — do not modify these
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  member        Member?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// HopeAfter50 Member data — linked to NextAuth User
// ============================================================

model Member {
  id                       String    @id @default(cuid())  // matches User.id
  firstName                String
  email                    String    @unique
  user                     User      @relation(fields: [id], references: [id])
  ageRange                 String?
  gender                   String?
  faithBasedEncouragement  Boolean   @default(false)
  contactPreference        String    @default("self_serve")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  assessment    Assessment?
  rebuildPlan   RebuildPlan?
  weeklyCheckIns WeeklyCheckIn[]
  milestones    MemberMilestone[]
}

model Assessment {
  id                  String   @id @default(cuid())
  memberId            String   @unique
  member              Member   @relation(fields: [memberId], references: [id])
  completedAt         DateTime @default(now())

  situation           String
  rebuildDuration     String
  primaryFear         String
  clarityLevel        String
  workInterests       String[] // stored as array
  financialRunway     String
  usingSavings        Boolean  @default(false)
  interviewFrequency  String
  hasCurrentResume    String
  aiToolsNeeded       String[]
  additionalContext   String?
  successVision       String?
}

model RebuildPlan {
  id                 String   @id @default(cuid())
  memberId           String   @unique
  member             Member   @relation(fields: [memberId], references: [id])
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  financialUrgency   Int      // 1-5
  currentStage       String
  careerDirections   String[]
  topPriorities      Json     // Priority[]
  recommendedToolIds String[]
  todaysAction       Json     // TodayAction
  strengths          String[]
  watchItems         String[]
  progressPercent    Int      @default(0)
}

model WeeklyCheckIn {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  week        String   // ISO week string e.g. "2025-W12"
  rating      String
  comment     String?
  submittedAt DateTime @default(now())
}

model MemberMilestone {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id])
  milestoneId String
  completedAt DateTime  @default(now())

  @@unique([memberId, milestoneId])
}
