// ============================================================
// HopeAfter50 — Database Schema
// Claude Code: run `npx prisma migrate dev` to create tables
// Recommended DB: Vercel Postgres or PlanetScale
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NextAuth required tables — do not modify these
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  member        Member?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// HopeAfter50 Member data — linked to NextAuth User
// ============================================================

model Member {
  id                      String   @id @default(cuid()) // matches User.id
  firstName               String
  email                   String   @unique
  user                    User     @relation(fields: [id], references: [id])
  ageRange                String?
  gender                  String?
  faithBasedEncouragement Boolean  @default(false)
  contactPreference       String   @default("self_serve")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // The member's original uploaded resume text, captured once on their
  // first upload and never overwritten. Optimized and tailored resumes
  // are always derived copies stored separately (ResumeAnalysis /
  // ResumeOptimization / ResumeTailoring) — this is the permanent source.
  baseResumeText    String?   @db.Text
  baseResumeFileUrl String?
  baseResumeSetAt   DateTime?

  assessment     Assessment?
  rebuildPlan    RebuildPlan?
  weeklyCheckIns WeeklyCheckIn[]
  milestones     MemberMilestone[]

  resumeAnalyses         ResumeAnalysis[]
  resumeOptimizations    ResumeOptimization[]
  resumeTailorings       ResumeTailoring[]
  opportunityEvaluations OpportunityEvaluation[]
  coverLetters           CoverLetter[]
  interviewPreps         InterviewPrep[]
  linkedInOptimizations  LinkedInOptimization[]
  partnerDonations       Partner[]
  dailyEncouragements    DailyEncouragement[]
}

model Assessment {
  id          String   @id @default(cuid())
  memberId    String   @unique
  member      Member   @relation(fields: [memberId], references: [id])
  completedAt DateTime @default(now())

  situation          String
  lastRole           String?
  jobLossDate        DateTime?
  rebuildDuration    String
  primaryFear        String
  clarityLevel       String
  workInterests      String[] // stored as array
  financialRunway    String
  usingSavings       Boolean   @default(false)
  interviewFrequency String
  hasCurrentResume   String
  aiToolsNeeded      String[]
  additionalContext  String?
  successVision      String?
}

model RebuildPlan {
  id          String   @id @default(cuid())
  memberId    String   @unique
  member      Member   @relation(fields: [memberId], references: [id])
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  financialUrgency   Int // 1-5
  currentStage       String
  careerDirections   String[]
  topPriorities      Json // Priority[]
  recommendedToolIds String[]
  todaysAction       Json // TodayAction
  strengths          String[]
  watchItems         String[]
  progressPercent    Int      @default(0)
}

model WeeklyCheckIn {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  week        String // ISO week string e.g. "2025-W12"
  rating      String
  comment     String?
  submittedAt DateTime @default(now())

  // Structured Weekly Review inputs (prompts/weekly-review.md)
  wins                    String? @db.Text
  progressNotes           String? @db.Text
  obstacles               String? @db.Text
  applicationsSubmitted   Int     @default(0)
  networkingConversations Int     @default(0)
  interviewsCompleted     Int     @default(0)
  offersReceived          Int     @default(0)
  newEmployment           Boolean @default(false)

  // Full AI response JSON (progress_rating, momentum, wins, top_obstacles,
  // current_focus, next_step, dashboard_updates, alerts, encouragement, ...)
  aiResponse Json?

  @@unique([memberId, week])
}

model MemberMilestone {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  milestoneId String
  completedAt DateTime @default(now())

  @@unique([memberId, milestoneId])
}

// ============================================================
// AI Tools — each stores the member's input plus the full AI
// JSON response (prompts/*.md). Never overwritten — kept as
// history so members can compare versions over time.
// ============================================================

model ResumeAnalysis {
  id               String   @id @default(cuid())
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id])
  resumeFileUrl    String? // Vercel Blob URL of the uploaded file
  resumeText       String   @db.Text
  targetRoles      String[]
  targetIndustries String[]
  analysis         Json // full prompts/resume-analysis.md output
  atsRating        String?
  overallRating    String?
  createdAt        DateTime @default(now())
}

model ResumeOptimization {
  id                      String   @id @default(cuid())
  memberId                String
  member                  Member   @relation(fields: [memberId], references: [id])
  resumeAnalysisId        String?
  optimizedResumeMarkdown String   @db.Text
  majorChanges            String[]
  recommendedFollowUp     String[]
  confidence              String?
  createdAt               DateTime @default(now())
}

model ResumeTailoring {
  id                     String   @id @default(cuid())
  memberId               String
  member                 Member   @relation(fields: [memberId], references: [id])
  resumeOptimizationId   String?
  jobDescription         String   @db.Text
  tailoredResumeMarkdown String   @db.Text
  matchScore             Int?
  matchLabel             String?
  tailoring              Json // full prompts/resume-tailoring.md output
  createdAt              DateTime @default(now())
}

model OpportunityEvaluation {
  id             String   @id @default(cuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id])
  jobTitle       String
  company        String
  jobDescription String   @db.Text
  evaluation     Json // full prompts/opportunity-evaluation.md output
  fitScore       Int?
  recommendation String?
  createdAt      DateTime @default(now())
}

model CoverLetter {
  id                      String   @id @default(cuid())
  memberId                String
  member                  Member   @relation(fields: [memberId], references: [id])
  opportunityEvaluationId String?
  jobTitle                String
  company                 String
  coverLetterMarkdown     String   @db.Text
  keyStrengths            String[]
  customizations          String[]
  confidence              String?
  createdAt               DateTime @default(now())
}

model InterviewPrep {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  jobTitle  String
  company   String
  prep      Json // full prompts/interview-prep.md output
  createdAt DateTime @default(now())
}

model LinkedInOptimization {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  headline   String?  @db.Text
  about      String?  @db.Text
  experience String?  @db.Text
  analysis   Json // AI response, based on prompts/resume-analysis.md guidance
  createdAt  DateTime @default(now())
}

// ============================================================
// Daily Word — one cached AI encouragement per member per day,
// shown on the dashboard and sent by the 7am cron email.
// ============================================================

model DailyEncouragement {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id])
  date        String // "YYYY-MM-DD" in America/Chicago
  message     String    @db.Text
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([memberId, date])
}

// ============================================================
// Support requests — submitted via the "Get Help" contact form
// (src/app/api/support/route.ts), also emailed to the team
// ============================================================

model SupportRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ============================================================
// Partner donations — voluntary support from members
// Created by the Stripe webhook once checkout.session.completed fires
// ============================================================

model Partner {
  id               String   @id @default(cuid())
  memberId         String?
  member           Member?  @relation(fields: [memberId], references: [id])
  email            String
  amount           Int // in cents
  interval         String // "monthly" | "one_time"
  stripeCustomerId String?
  stripeSessionId  String   @unique
  status           String   @default("complete")
  createdAt        DateTime @default(now())
}
