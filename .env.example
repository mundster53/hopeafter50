# ============================================================
# HopeAfter50 — Environment Variables
# Copy this to .env.local and fill in your values
# Add these same values to Vercel Dashboard → Settings → Environment Variables
# ============================================================

# Database (Vercel Postgres recommended)
DATABASE_URL="postgresql://..."

# Anthropic API (for Resume Intelligence, AI tools)
ANTHROPIC_API_KEY="sk-ant-..."

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Email (for contact preference delivery)
# Resend recommended: https://resend.com
RESEND_API_KEY="re_..."
FROM_EMAIL="hello@hopeafter50.com"

# File storage (resume uploads, generated documents)
# Vercel Dashboard → Storage → Create Database → Blob
# Auto-injected by Vercel when the Blob store is connected to this project;
# set it manually here for local development.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
