# ============================================================
# HopeAfter50 — Environment Variables
# Copy this to .env.local and fill in your values
# Add these same values to Vercel Dashboard → Settings → Environment Variables
# ============================================================

# Database (Vercel Postgres recommended)
DATABASE_URL="postgresql://..."

# Anthropic API (for Resume Intelligence, AI tools)
ANTHROPIC_API_KEY="sk-ant-..."

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Email (for contact preference delivery)
# Resend recommended: https://resend.com
RESEND_API_KEY="re_..."
FROM_EMAIL="hello@hopeafter50.com"
